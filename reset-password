<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>MΛTOBΛ — Nouveau mot de passe</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--ink:#0a0a0a;--white:#fff;--fog:#f7f6f4;--rule:#d8d5cf;--stone:#6b6762;--green:#2d6a4f;--green-light:#e8f5ef;--red:#c0392b;--red-light:#fdf0ef}
*{box-sizing:border-box;margin:0;padding:0}body{min-height:100svh;display:grid;place-items:center;padding:24px;background:linear-gradient(180deg,#fff,var(--fog));font-family:Inter,sans-serif;color:var(--ink)}
.card{width:min(100%,460px);padding:38px;border:1px solid var(--rule);border-radius:28px;background:#fff;box-shadow:0 24px 70px rgba(10,10,10,.09)}
.brand{text-align:center;font-size:17px;font-weight:200;letter-spacing:.52em;padding-left:.52em}.sub{text-align:center;margin-top:8px;font-size:8px;letter-spacing:.16em;text-transform:uppercase;color:var(--stone)}
h1{margin-top:42px;font-size:36px;font-weight:300;line-height:1.05;letter-spacing:-.035em}.intro{margin:16px 0 26px;color:var(--stone);font-size:13px;line-height:1.7}
label{display:block;margin-bottom:7px;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:var(--stone)}input{width:100%;min-height:52px;padding:14px 16px;border:1px solid var(--rule);border-radius:14px;font:inherit;font-size:16px;outline:0}input:focus{border-color:var(--ink)}button{width:100%;min-height:52px;margin-top:16px;border:0;border-radius:999px;background:var(--ink);color:#fff;font-size:11px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer}.msg{display:none;margin-top:16px;padding:13px 14px;border-radius:13px;font-size:12px;line-height:1.55}.error{background:var(--red-light);color:var(--red)}.ok{background:var(--green-light);color:var(--green)}
@media(max-width:600px){.card{padding:28px 20px;border-radius:24px}h1{font-size:31px}}
</style>
</head>
<body>
<main class="card">
  <div class="brand">MΛTOBΛ</div>
  <div class="sub">Conception · Ingénierie · Construction</div>
  <h1>Choisissez votre nouveau mot de passe.</h1>
  <p class="intro">Saisissez un mot de passe d’au moins huit caractères.</p>
  <label for="password">Nouveau mot de passe</label>
  <input id="password" type="password" minlength="8" autocomplete="new-password" placeholder="••••••••">
  <label for="confirm" style="margin-top:14px">Confirmer</label>
  <input id="confirm" type="password" minlength="8" autocomplete="new-password" placeholder="••••••••">
  <button id="submit" onclick="updatePassword()">Enregistrer</button>
  <div id="error" class="msg error"></div>
  <div id="ok" class="msg ok">Mot de passe mis à jour. Redirection vers votre espace…</div>
</main>
<script>
const client=window.supabase.createClient('https://xfvbbcoozcgvelcyucch.supabase.co','sb_publishable_6QzdaJQvVSLFM62FV_Vljg_lqDy3-FP');
async function updatePassword(){
 const p=document.getElementById('password').value,c=document.getElementById('confirm').value,e=document.getElementById('error'),b=document.getElementById('submit');
 e.style.display='none';
 if(p.length<8){e.textContent='Le mot de passe doit contenir au moins huit caractères.';e.style.display='block';return}
 if(p!==c){e.textContent='Les deux mots de passe ne correspondent pas.';e.style.display='block';return}
 b.disabled=true;b.textContent='Enregistrement…';
 const {error}=await client.auth.updateUser({password:p});
 if(error){e.textContent=error.message;e.style.display='block';b.disabled=false;b.textContent='Enregistrer';return}
 document.getElementById('ok').style.display='block';setTimeout(()=>location.href='/suivi-chantier.html',1500);
}
</script>
</body>
</html>
